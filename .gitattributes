# Normalize text files to LF in the repository
* text=auto eol=lf

*.md     text eol=lf
*.py     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE  text eol=lf

# Binary assets
*.png    binary
*.gif    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
